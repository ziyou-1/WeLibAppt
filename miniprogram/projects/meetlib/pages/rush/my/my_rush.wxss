/* ============================================================
 * 我的闪抢预约
 * 设计 token 同 rush_detail：品牌 #16475A / 危险 #DC2626
 * ============================================================ */

page {
	background: #F3F5F7;
}

.my-wrap {
	padding: 24rpx;
}

.my-card {
	background: #fff;
	border-radius: 24rpx;
	padding: 32rpx;
	margin-bottom: 24rpx;
	box-shadow: 0 8rpx 32rpx rgba(22, 71, 90, 0.08);
}

.my-hd {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.my-hd .title {
	flex: 1;
	font-size: 34rpx;
	font-weight: 700;
	color: #1F2937;
	margin-right: 16rpx;
}

.my-hd .status {
	font-size: 24rpx;
	font-weight: 600;
	padding: 6rpx 22rpx;
	border-radius: 999rpx;
	flex-shrink: 0;
}

.my-hd .status.s0 {
	color: #16475A;
	background: #EAF1F4;
}

.my-hd .status.s1 {
	color: #059669;
	background: #E7F8EF;
}

.my-hd .status.s2 {
	color: #6B7280;
	background: #F0F2F4;
}

/* ---------------- 购买码 ---------------- */
.my-code {
	display: flex;
	align-items: center;
	margin-top: 28rpx;
	padding: 28rpx 32rpx;
	background: linear-gradient(135deg, #16475A 0%, #1F6B86 100%);
	border-radius: 18rpx;
	box-shadow: 0 8rpx 24rpx rgba(22, 71, 90, 0.22);
}

.my-code .label {
	font-size: 24rpx;
	color: rgba(255, 255, 255, 0.82);
	margin-right: 24rpx;
	flex-shrink: 0;
}

.my-code .val {
	flex: 1;
	font-family: "SF Mono", Menlo, Consolas, monospace;
	font-size: 48rpx;
	font-weight: 700;
	color: #fff;
	letter-spacing: 5rpx;
	line-height: 1.15;
}

.my-code .copy {
	font-size: 25rpx;
	color: #fff;
	border: 2rpx solid rgba(255, 255, 255, 0.45);
	border-radius: 999rpx;
	padding: 10rpx 28rpx;
	flex-shrink: 0;
	transition: background 0.15s;
}

.my-code .copy:active {
	background: rgba(255, 255, 255, 0.16);
}

/* ---------------- 明细 ---------------- */
.my-body {
	margin-top: 24rpx;
}

.my-row {
	display: flex;
	padding: 12rpx 0;
	font-size: 27rpx;
}

.my-row .k {
	width: 176rpx;
	color: #6B7280;
	flex-shrink: 0;
}

.my-row .v {
	flex: 1;
	color: #4B5563;
}

.my-row .v.strong {
	color: #16475A;
	font-weight: 700;
	font-size: 30rpx;
}

/* ---------------- 底部操作 ---------------- */
.my-foot {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-top: 24rpx;
	padding-top: 24rpx;
	border-top: 2rpx solid #F0F2F4;
	font-size: 25rpx;
}

.my-foot .tip {
	color: #9CA3AF;
}

.my-foot .right {
	display: flex;
	align-items: center;
}

.my-foot .cancel {
	color: #DC2626;
	font-weight: 600;
	margin-right: 32rpx;
	padding: 12rpx 0;
}

.my-foot .cancel:active {
	opacity: 0.65;
}

.my-foot .more {
	color: #16475A;
	font-weight: 600;
	padding: 12rpx 0;
}

.my-foot .more:active {
	opacity: 0.65;
}

/* ---------------- 空态 ---------------- */
.my-empty {
	padding-top: 220rpx;
	text-align: center;
}

.my-empty .txt {
	font-size: 30rpx;
	color: #6B7280;
}

.my-empty .sub {
	margin-top: 16rpx;
	font-size: 25rpx;
	color: #9CA3AF;
}

.my-loading {
	padding-top: 320rpx;
	text-align: center;
	font-size: 28rpx;
	color: #6B7280;
}
